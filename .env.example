# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
# Example Atlas URI: mongodb+srv://username:password@cluster0.abcde.mongodb.net/expenseflow?retryWrites=true&w=majority
# Example Local URI: mongodb://127.0.0.1:27017/expenseflow
MONGO_URI=mongodb://127.0.0.1:27017/expenseflow
